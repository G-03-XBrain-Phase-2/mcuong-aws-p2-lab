# Local .terraform directories
**/.terraform/*

# .tfstate files
**/*.tfstate
**/*.tfstate.*

# Crash log files
**/crash.log
**/crash.*.log

# Exclude sensitive tfvars files (like secrets.tfvars)
# But keep example templates
**/*.tfvars
!**/*.tfvars.example
!**/*.tfvars.json.example

# Ignore override files
**/*_override.tf
**/*_override.tf.json
**/override.tf
**/override.tf.json

# Private keys generated locally
**/*.pem

# Local kubeconfig files
**/kubeconfig
!**/dummy_kubeconfig

# macOS system files
**/.DS_Store
notice
YEU_CAU_DE_BAI.md

# Local working files & slide documents
*.drawio
*.drawio.bkp
k8s-part2-in-practice*.html
